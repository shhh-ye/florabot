# Скопируйте эти переменные в настройки Render (Environment) — см. README.md
# Файл .env НЕ нужно загружать на GitHub, он только для примера.

OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o
TELEGRAM_BOT_TOKEN=123456789:AAверитеTokenOtBotFather
TELEGRAM_WEBHOOK_SECRET=придумайте_любую_строку_например_moi_bot_2026

# Instagram — необязательно, добавьте когда решится вопрос с Facebook-аккаунтом
IG_ACCESS_TOKEN=ваш_токен_доступа_instagram
IG_VERIFY_TOKEN=придумайте_любую_строку_например_moi_bot_ig_2026

# Google Таблица — необязательно. Если задана, её строки попадают в RAG-индекс,
# а у бота остаётся инструмент точного поиска по таблице.
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
GOOGLE_CREDENTIALS_JSON={"type": "service_account", "project_id": "...", ...}

# --- RAG (все переменные необязательные, значения по умолчанию разумные) ---
# Модель для embeddings (векторов)
EMBEDDING_MODEL=text-embedding-3-small
# Папка с документами базы знаний
KNOWLEDGE_DIR=knowledge
# Папка, куда ChromaDB сохраняет векторный индекс
CHROMA_DIR=.chroma
# Сколько фрагментов знаний подставлять в контекст модели
RAG_TOP_K=6
# Размер фрагмента при разбиении документов (в символах) и перекрытие
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# Сколько последних сообщений помнить в диалоге с каждым клиентом
HISTORY_MAX_MESSAGES=10
