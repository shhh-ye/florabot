# Скопируйте эти переменные в настройки Render (Environment) — см. README.md
# Файл .env НЕ нужно загружать на GitHub, он только для примера.

OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o
TELEGRAM_BOT_TOKEN=123456789:AAверитеTokenOtBotFather
TELEGRAM_WEBHOOK_SECRET=придумайте_любую_строку_например_moi_bot_2026

# Instagram — необязательно, добавьте когда решится вопрос с Facebook-аккаунтом
IG_ACCESS_TOKEN=ваш_токен_доступа_instagram
IG_VERIFY_TOKEN=придумайте_любую_строку_например_moi_bot_ig_2026

# Google Таблица — необязательно. Если задана, описания товаров попадают
# в RAG-индекс (для умного подбора), а цены и наличие бот всегда читает
# из таблицы живьём в момент ответа — они актуальны в реальном времени.
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
GOOGLE_CREDENTIALS_JSON={"type": "service_account", "project_id": "...", ...}

# Какие колонки таблицы считать волатильными (цены/остатки) — они НЕ попадают
# в RAG-индекс. Сравнение по подстроке в названии колонки, без учёта регистра.
# Менять нужно только если ваши колонки называются нестандартно.
SHEET_VOLATILE_COLUMNS=цена,стоимость,наличие,остаток,количество,кол-во,скидка,price,cost,stock,quantity,qty,amount,discount

# Папка со скиллами — постоянными правилами поведения бота (необязательно).
# Один скилл = один .md-файл, входит в каждый запрос целиком.
# Выключить скилл, не удаляя: переименовать файл в имя.md.off
SKILLS_DIR=skills

# --- RAG (все переменные необязательные, значения по умолчанию разумные) ---
# Модель для embeddings (векторов)
EMBEDDING_MODEL=text-embedding-3-small
# Папка с документами базы знаний
KNOWLEDGE_DIR=knowledge
# Файл, в котором сохраняется векторный индекс (JSON)
RAG_INDEX_PATH=.rag_index.json
# Сколько фрагментов знаний подставлять в контекст модели
RAG_TOP_K=6
# Размер фрагмента при разбиении документов (в символах) и перекрытие
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# Сколько последних сообщений помнить в диалоге с каждым клиентом
HISTORY_MAX_MESSAGES=10

# Таймауты внешних запросов, секунды (необязательно)
# OpenAI (генерация ответа, embeddings)
OPENAI_TIMEOUT=60
# Telegram/Instagram API и Google Sheets
HTTP_TIMEOUT=20

# --- Анти-усыпление на free-плане Render (необязательно) --------------------
# Free-план Render усыпляет сервис после 15 минут без входящих запросов.
# После этого первое сообщение будит его холодным стартом, и ответ может
# не дойти. Чтобы сервис не засыпал, он пингует свой публичный URL.
# RENDER_EXTERNAL_URL Render подставляет сам — задавать вручную не нужно.
# Здесь можно только изменить период пинга (секунды) или выключить его (0).
KEEPALIVE_INTERVAL=600
